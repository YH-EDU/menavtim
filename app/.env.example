# 1 = כל שלבי המפה פתוחים לבדיקה.
# לא מסמן משימות כגמורות ולא פותח את דלת סוף השלב.
# אפשר גם ?unlockAll=1 בכתובת (נשמר בדפדפן) ו-?unlockAll=0 לכיבוי.
VITE_UNLOCK_ALL=

# Supabase → Project Settings → API
# Project URL, והמפתח הציבורי anon. בלי שניהם אזור המורים מציג שהשרת לא מחובר.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
